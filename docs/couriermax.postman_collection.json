{
  "info": {
    "name": "CourierMax API",
    "description": "Colección de pruebas para CourierMax API (prueba técnica .NET Senior).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    { "name": "Health", "request": { "method": "GET", "url": "{{baseUrl}}/health" } },
    { "name": "List cities", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/Reference/cities" } },
    { "name": "List vehicles", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/Reference/vehicles" } },
    { "name": "Quote", "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/Shipments/quote",
        "body": { "mode": "raw", "raw": "{\n  \"sender\": {\"name\":\"Juan\",\"phone\":\"3105551234\",\"address\":\"Calle 100 #15-20\"},\n  \"recipient\": {\"name\":\"Ana\",\"phone\":\"6015554321\",\"address\":\"Carrera 50 #30-10\"},\n  \"weightKg\": 5,\n  \"lengthCm\": 20, \"widthCm\": 20, \"heightCm\": 20,\n  \"packageType\": 2, \"serviceType\": 1,\n  \"originCity\": \"Bogotá\", \"destinationCity\": \"Medellín\"\n}" }
      }
    },
    { "name": "Create shipment", "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/Shipments",
        "body": { "mode": "raw", "raw": "{\n  \"sender\": {\"name\":\"Juan\",\"phone\":\"3105551234\",\"address\":\"Calle 100 #15-20\"},\n  \"recipient\": {\"name\":\"Ana\",\"phone\":\"6015554321\",\"address\":\"Carrera 50 #30-10\"},\n  \"weightKg\": 5,\n  \"lengthCm\": 20, \"widthCm\": 20, \"heightCm\": 20,\n  \"packageType\": 2, \"serviceType\": 1,\n  \"originCity\": \"Bogotá\", \"destinationCity\": \"Medellín\"\n}" }
      }
    },
    { "name": "Auto assign", "request": { "method": "POST", "url": "{{baseUrl}}/api/v1/Shipments/{{shipmentId}}/auto-assign" } },
    { "name": "Start transit", "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/Shipments/{{shipmentId}}/start-transit",
        "body": { "mode": "raw", "raw": "{ \"actorId\": \"driver-1\" }" }
      }
    },
    { "name": "Deliver", "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/Shipments/{{shipmentId}}/deliver",
        "body": { "mode": "raw", "raw": "{ \"actorId\": \"driver-1\" }" }
      }
    },
    { "name": "Cancel", "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/v1/Shipments/{{shipmentId}}/cancel",
        "body": { "mode": "raw", "raw": "{ \"reason\": \"cliente cancela\", \"actorId\": \"operator\" }" }
      }
    },
    { "name": "Driver metrics", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/reports/drivers/{{driverId}}/metrics" } },
    { "name": "Overdue", "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/reports/overdue" } }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5080" },
    { "key": "shipmentId", "value": "1" },
    { "key": "driverId", "value": "1" }
  ]
}
